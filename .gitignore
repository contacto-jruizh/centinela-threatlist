# ===== Centinela ThreatList - .gitignore =====
# NO subir secretos, tokens ni basura local

# --- Secretos / API keys / credenciales ---
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.asc
*.gpg
credentials*.json
*credentials*.json
secrets*.json
*secret*.txt
config.local.json
*.token
.npmrc
.envrc
id_rsa*
id_ed25519*
*.jks
*.keystore
google-services.json
GoogleService-Info.plist
*.mobileprovision
*.tfstate
*.tfstate.*
*.tfvars
*.auto.tfvars
.github/workflows/secrets/

# --- Archivos de agente / memoria local (NO versionar) ---
AGENTS.md
MEMORY.md
.opencode/
.claude/
.opendev/
.ai/
memory/
sessions/

# --- macOS basura ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop

# --- Windows basura ---
Thumbs.db
Thumbs.db:encryptionkey
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Linux basura ---
*~

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Node (por si agregas tooling) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editores / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
.project
.classpath
.settings/

# --- Cache local del generador (NO versionar: CI los re-baja con --auto) ---
data/*/hosts
!data/custom/hosts
*.log
data/tranco/
# JSON crudo de PhishTank: contiene URLs-cebo de atacantes con patrones que
# activan GitHub Push Protection (AWSAccessKeyId en URLs S3 pre-firmadas).
# No aporta nada publicado: update.py lo re-fetcha en cada --auto.
data/PhishTank/

# Nota: bulk/ (categorias) SI se versiona en main. dist/ queda ignorado (scratch).
